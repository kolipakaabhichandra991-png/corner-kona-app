generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Category {
  id        String   @id @default(cuid())
  key       String   @unique
  slug      String   @unique
  name      Json
  blurb     Json
  image     String
  children  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Episode {
  id                String              @id
  slug              String              @unique
  kind              String
  releaseType       String?
  seriesTitle       Json?
  seasonNumber      Int?
  episodeNumber     Int?
  totalEpisodes     Int?
  youtubeId         String?
  audioUrl          String?
  videoUrl          String?
  thumbnailUrl      String?
  title             Json
  show              Json
  category          String
  durationMin       Int
  image             String
  premium           Boolean             @default(false)
  language          String              @default("hi")
  publishedAt       DateTime
  formats           Json?
  chapters          Chapter[]
  transcripts       TranscriptLine[]
  listeningProgress ListeningProgress[]
  heroConfigs       HeroConfig[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Story {
  id          String   @id
  slug        String   @unique
  title       Json
  dek         Json
  category    String
  image       String
  readMin     Int
  publishedAt DateTime
  formats     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Short {
  id          String   @id
  slug        String   @unique
  title       Json
  category    String
  durationSec Int
  image       String
  views       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveBlog {
  id        String      @id
  slug      String      @unique
  active    Boolean     @default(true)
  title     Json
  category  String
  entries   LiveEntry[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model LiveEntry {
  id         String   @id
  liveBlogId String
  liveBlog   LiveBlog @relation(fields: [liveBlogId], references: [id], onDelete: Cascade)
  type       String
  at         DateTime
  body       Json?
  storyId    String?
  shortId    String?
  createdAt  DateTime @default(now())

  @@index([liveBlogId])
}

model HeroConfig {
  id        String   @id @default("default")
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  kicker    Json
  summary   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chapter {
  id        String   @id
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title     Json
  start     Int
  createdAt DateTime @default(now())

  @@index([episodeId])
}

model TranscriptLine {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  start     Float
  end       Float
  speaker   String?
  hi        String   @db.Text
  en        String   @db.Text
  createdAt DateTime @default(now())

  @@index([episodeId])
}

model Comment {
  id         String    @id @default(cuid())
  contentId  String
  parentId   String?
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")
  authorName String
  userId     String?
  body       String    @db.Text
  likes      Int       @default(0)
  reported   Boolean   @default(false)
  status     String    @default("approved")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  commentLikes      CommentLike[]
  commentReports    CommentReport[]
  moderationActions ModerationAction[]

  @@index([contentId])
  @@index([parentId])
}

model ListeningProgress {
  id          String   @id @default(cuid())
  visitorId   String
  episodeId   String
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSec Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([visitorId, episodeId])
  @@index([visitorId])
  @@index([episodeId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model CommentReport {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

model ModerationAction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  action    String
  adminName String
  note      String?
  createdAt DateTime @default(now())

  @@index([commentId])
}